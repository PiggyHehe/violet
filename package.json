{
    "name":  "violet",
    "version":  "1.1.3",
    "main":  "main.js",
    "bin":  {
                "muriel":  "./cli.js"
            },
    "scripts":  {
                    "start":  "electron .",
                    "test":  "node --test",
                    "dist":  "electron-builder",
                    "release":  "npm version patch \u0026\u0026 git push --follow-tags",
                    "release:minor":  "npm version minor \u0026\u0026 git push --follow-tags",
                    "release:major":  "npm version major \u0026\u0026 git push --follow-tags"
                },
    "keywords":  [

                 ],
    "author":  "cloverscripts",
    "license":  "MIT",
    "description":  "Violet - an elegant liquid glass music player.",
    "devDependencies":  {
                            "@capacitor/android":  "^8.5.3",
                            "@capacitor/app":  "^8.1.2",
                            "@capacitor/cli":  "^8.5.3",
                            "@capacitor/core":  "^8.5.3",
                            "@capacitor/filesystem":  "^8.1.4",
                            "@capacitor/ios":  "^8.5.3",
                            "@capacitor/share":  "^8.0.3",
                            "buffer":  "^6.0.3",
                            "electron":  "^41.7.1",
                            "electron-builder":  "^26.15.3",
                            "esbuild":  "^0.28.2",
                            "events":  "^3.3.0",
                            "path-browserify":  "^1.0.1",
                            "youtubei.js":  "^18.1.0"
                        },
    "dependencies":  {
                         "cfonts":  "^3.3.1",
                         "hls.js":  "^1.7.1",
                         "tone":  "^15.1.22"
                     },
    "productName":  "Violet",
    "homepage":  "https://github.com/PiggyHehe/violet",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/PiggyHehe/violet.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/PiggyHehe/violet/issues"
             },
    "build":  {
                  "appId":  "io.github.cloverscripts.violet",
                  "productName":  "Violet",
                  "artifactName":  "${name}-${version}-${os}-${arch}.${ext}",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "**/*",
                                "!.github/**",
                                "!dist/**",
                                "!bin/**",
                                "!mobile/**",
                                "!www/**",
                                "!ios/**",
                                "!android/**",
                                "!tools/**",
                                "!capacitor.config.json",
                                "!.claude/**",
                                "!vendor/**",
                                "!*.md",
                                "!strip_comments.js",
                                "!package-lock.json"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "assets/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  false,
                               "deleteAppDataOnUninstall":  false
                           },
                  "linux":  {
                                "target":  [
                                               {
                                                   "target":  "AppImage",
                                                   "arch":  [
                                                                "x64"
                                                            ]
                                               }
                                           ],
                                "icon":  "assets/icon.png",
                                "category":  "AudioVideo"
                            },
                  "mac":  {
                              "category":  "public.app-category.music",
                              "target":  [
                                             {
                                                 "target":  "dmg",
                                                 "arch":  [
                                                              "x64",
                                                              "arm64"
                                                          ]
                                             },
                                             {
                                                 "target":  "zip",
                                                 "arch":  [
                                                              "x64",
                                                              "arm64"
                                                          ]
                                             }
                                         ],
                              "identity":  null,
                              "hardenedRuntime":  false,
                              "gatekeeperAssess":  false,
                              "artifactName":  "${productName}-${version}-mac-${arch}.${ext}"
                          },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "cloverscripts",
                                      "repo":  "riff-muriel",
                                      "releaseType":  "release"
                                  }
                              ]
              }
}
